# Database (MySQL via Prisma)
DATABASE_URL="mysql://root:@localhost:3306/cleanmate"

# NextAuth
NEXTAUTH_SECRET="cleanmate_super_secret_key_123456"
NEXTAUTH_URL="http://localhost:3000/"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gmail SMTP Configuration for sending real OTP Emails
# GMAIL_USER: Địa chỉ Gmail gửi tin (ví dụ: cleanmate.noreply@gmail.com)
# GMAIL_APP_PASSWORD: Mật khẩu ứng dụng 16 ký tự tạo từ Google Account (Security -> 2-Step Verification -> App Passwords)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
